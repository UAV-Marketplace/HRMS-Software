# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file (it is already in .gitignore).

# --- Core Django settings ---
# Must be False in production.
DEBUG=False

# Generate a fresh, unique secret key for production, e.g.:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

TIME_ZONE=Asia/Kolkata

# Comma-separated list of the exact domain(s)/IP(s) the app will be served from.
# Do NOT include "*" in production.
ALLOWED_HOSTS=yourdomain.com

# Comma-separated list of scheme+host origins allowed to submit CSRF-protected
# requests. Must use https:// once the app is behind SSL.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Password required to access the one-time "initialize/load demo database" wizard.
# Set to a strong random value; the wizard is disabled automatically once real data exists.
DB_INIT_PASSWORD=

# --- Database ---
# Only used for local/non-Docker runs. When running via docker-compose, the
# DATABASE_URL environment variable set in docker-compose.yaml takes priority.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=horilla_main
DB_USER=horilla
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
